diff --git a/third_party/blink/common/fingerprint/fingerprint_config.cc b/third_party/blink/common/fingerprint/fingerprint_config.cc
new file mode 100644
index 0000000000..6125251882
--- /dev/null
+++ b/third_party/blink/common/fingerprint/fingerprint_config.cc
@@ -0,0 +1,187 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/fingerprint/fingerprint_config.h"
+
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/hash/hash.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "third_party/blink/public/common/switches.h"
+
+namespace blink::fingerprint {
+
+namespace {
+
+uint64_t SplitMix64(uint64_t x) {
+  x += 0x9E3779B97F4A7C15ull;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ull;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBull;
+  return x ^ (x >> 31);
+}
+
+struct Config {
+  Config() {
+    const base::CommandLine* command_line =
+        base::CommandLine::ForCurrentProcess();
+    if (!command_line->HasSwitch(switches::kFingerprint)) {
+      return;
+    }
+    const std::string seed_string =
+        command_line->GetSwitchValueASCII(switches::kFingerprint);
+    if (seed_string.empty()) {
+      return;
+    }
+    enabled = true;
+    // Accept plain integers, but fall back to hashing so that arbitrary
+    // strings (profile names, UUIDs) can be used as seeds too.
+    uint64_t numeric_seed = 0;
+    if (base::StringToUint64(seed_string, &numeric_seed)) {
+      seed = SplitMix64(numeric_seed);
+    } else {
+      seed = SplitMix64(base::PersistentHash(seed_string));
+    }
+
+    unsigned concurrency = 0;
+    if (base::StringToUint(
+            command_line->GetSwitchValueASCII(
+                switches::kFingerprintHardwareConcurrency),
+            &concurrency) &&
+        concurrency > 0) {
+      hardware_concurrency = concurrency;
+    }
+
+    double memory_gb = 0;
+    if (base::StringToDouble(command_line->GetSwitchValueASCII(
+                                 switches::kFingerprintDeviceMemory),
+                             &memory_gb) &&
+        memory_gb > 0) {
+      device_memory = static_cast<float>(memory_gb);
+    }
+
+    platform = ReadString(*command_line, switches::kFingerprintPlatform);
+    gpu_vendor = ReadString(*command_line, switches::kFingerprintGpuVendor);
+    gpu_renderer = ReadString(*command_line, switches::kFingerprintGpuRenderer);
+  }
+
+  static std::optional<std::string> ReadString(
+      const base::CommandLine& command_line,
+      std::string_view name) {
+    if (!command_line.HasSwitch(name)) {
+      return std::nullopt;
+    }
+    // GetSwitchValueUTF8 rather than ASCII: GPU renderer strings contain
+    // characters such as "(R)" / "(TM)" and occasionally non-ASCII ones.
+    std::string value = command_line.GetSwitchValueUTF8(name);
+    if (value.empty()) {
+      return std::nullopt;
+    }
+    return value;
+  }
+
+  bool enabled = false;
+  uint64_t seed = 0;
+  std::optional<unsigned> hardware_concurrency;
+  std::optional<float> device_memory;
+  std::optional<std::string> platform;
+  std::optional<std::string> gpu_vendor;
+  std::optional<std::string> gpu_renderer;
+};
+
+const Config& GetConfig() {
+  static const base::NoDestructor<Config> config;
+  return *config;
+}
+
+}  // namespace
+
+bool IsEnabled() {
+  return GetConfig().enabled;
+}
+
+uint64_t Seed() {
+  return GetConfig().seed;
+}
+
+uint64_t Mix(uint64_t value) {
+  return SplitMix64(GetConfig().seed ^ SplitMix64(value));
+}
+
+std::optional<unsigned> HardwareConcurrencyOverride() {
+  return GetConfig().hardware_concurrency;
+}
+
+std::optional<float> DeviceMemoryOverride() {
+  return GetConfig().device_memory;
+}
+
+std::optional<std::string> PlatformOverride() {
+  return GetConfig().platform;
+}
+
+std::optional<std::string> GpuVendorOverride() {
+  return GetConfig().gpu_vendor;
+}
+
+std::optional<std::string> GpuRendererOverride() {
+  return GetConfig().gpu_renderer;
+}
+
+void PerturbPixels8888(base::span<uint8_t> pixels) {
+  if (!IsEnabled()) {
+    return;
+  }
+  // `previous` holds the *original* value of the preceding pixel so that the
+  // decision for each pixel depends only on unmodified content.
+  uint32_t previous = 0;
+  bool has_previous = false;
+  uint64_t index = 0;
+  while (pixels.size() >= 4) {
+    base::span<uint8_t> pixel = pixels.first(4u);
+    const uint32_t value = (static_cast<uint32_t>(pixel[0]) << 24) |
+                           (static_cast<uint32_t>(pixel[1]) << 16) |
+                           (static_cast<uint32_t>(pixel[2]) << 8) |
+                           static_cast<uint32_t>(pixel[3]);
+    // Only touch pixels on a colour transition (anti-aliased edges, text,
+    // gradients). Flat fills and fully transparent pixels stay exact, which
+    // keeps trivially verifiable content (e.g. a solid fillRect) unchanged.
+    if (has_previous && value != previous && pixel[3] != 0) {
+      const uint64_t h = Mix((index << 32) ^ value);
+      if ((h & 0xF) == 0) {
+        const size_t channel = static_cast<size_t>((h >> 4) % 3);
+        const uint8_t flipped = static_cast<uint8_t>(pixel[channel] ^ 1u);
+        // Never exceed alpha, so premultiplied pixels stay valid.
+        if (flipped <= pixel[3]) {
+          pixel[channel] = flipped;
+        }
+      }
+    }
+    previous = value;
+    has_previous = true;
+    ++index;
+    pixels = pixels.subspan(4u);
+  }
+}
+
+void PerturbAudioSamples(base::span<float> samples) {
+  if (!IsEnabled()) {
+    return;
+  }
+  // Gain within 1 +/- 5e-6: far below audibility, but enough to change the
+  // low-order bits that audio fingerprints sum over.
+  const double unit = static_cast<double>(Mix(0x617564696F) >> 11) /
+                      static_cast<double>(1ull << 53);
+  float gain = static_cast<float>(1.0 + (unit - 0.5) * 1e-5);
+  if (gain == 1.0f) {
+    // The offset rounded away in single precision; keep the noise non-zero.
+    gain = 1.0f + 1e-6f;
+  }
+  for (float& sample : samples) {
+    sample *= gain;
+  }
+}
+
+}  // namespace blink::fingerprint
