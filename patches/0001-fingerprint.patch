+// static
+void ImageDataBuffer::ApplyFingerprintNoise(const SkPixmap& pixmap) {
+  if (!fingerprint::IsEnabled() || !pixmap.addr()) {
+    return;
+  }
+  if (pixmap.colorType() != kRGBA_8888_SkColorType &&
+      pixmap.colorType() != kBGRA_8888_SkColorType) {
+    return;
+  }
+  // The noise routine expects tightly packed rows.
+  if (pixmap.rowBytes() != pixmap.info().minRowBytes()) {
+    return;
+  }
+  fingerprint::PerturbPixels8888(gfx::SkPixmapToWritableSpan(pixmap));
+}
+
+void ImageDataBuffer::ApplyFingerprintNoise() {
+  if (!is_valid_ || !fingerprint::IsEnabled()) {
+    return;
+  }
+  const SkImageInfo info = pixmap_.info();
+  const size_t row_bytes = info.minRowBytes();
+  const size_t size = info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(size)) {
+    return;
+  }
+  sk_sp<SkData> data = SkData::MakeUninitialized(size);
+  SkPixmap copy(info, data->writable_data(), row_bytes);
+  if (!pixmap_.readPixels(copy)) {
+    return;
+  }
+  ApplyFingerprintNoise(copy);
+  pixmap_ = copy;
+  retained_image_ = SkImages::RasterFromData(info, std::move(data), row_bytes);
+}
