diff --git a/third_party/blink/public/common/fingerprint/fingerprint_config.h b/third_party/blink/public/common/fingerprint/fingerprint_config.h
new file mode 100644
index 0000000000..5cd248edf3
--- /dev/null
+++ b/third_party/blink/public/common/fingerprint/fingerprint_config.h
@@ -0,0 +1,63 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_FINGERPRINT_CONFIG_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_FINGERPRINT_CONFIG_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+
+#include "base/containers/span.h"
+#include "third_party/blink/public/common/common_export.h"
+
+namespace blink::fingerprint {
+
+// Command-line driven fingerprint configuration. Everything here is inert
+// unless the browser was started with --fingerprint=<seed>; the individual
+// --fingerprint-* overrides are only honoured when a seed is present.
+//
+// All values are read once from the current process' command line (the
+// browser forwards the switches to renderers) and cached, so these functions
+// are cheap and safe to call from any thread.
+
+// True when --fingerprint=<seed> was supplied.
+BLINK_COMMON_EXPORT bool IsEnabled();
+
+// The 64-bit seed derived from --fingerprint. 0 when disabled.
+BLINK_COMMON_EXPORT uint64_t Seed();
+
+// Stateless 64-bit mixer (splitmix64 finalizer) combining the seed with
+// `value`. The same seed and value always produce the same output.
+BLINK_COMMON_EXPORT uint64_t Mix(uint64_t value);
+
+// --fingerprint-hardware-concurrency=<n>
+BLINK_COMMON_EXPORT std::optional<unsigned> HardwareConcurrencyOverride();
+
+// --fingerprint-device-memory=<gb>
+BLINK_COMMON_EXPORT std::optional<float> DeviceMemoryOverride();
+
+// --fingerprint-platform=<navigator.platform value>, e.g. "Win32".
+BLINK_COMMON_EXPORT std::optional<std::string> PlatformOverride();
+
+// --fingerprint-gpu-vendor / --fingerprint-gpu-renderer: values reported
+// through WEBGL_debug_renderer_info.
+BLINK_COMMON_EXPORT std::optional<std::string> GpuVendorOverride();
+BLINK_COMMON_EXPORT std::optional<std::string> GpuRendererOverride();
+
+// Applies seed-keyed noise to a buffer of tightly packed 8-bit, 4-channel
+// pixels (RGBA or BGRA; the alpha channel must be last). The noise is a
+// pure function of (seed, pixel position, pixel value), so reading the same
+// content back twice gives identical results. Fully transparent pixels and
+// pixels inside flat-colour runs are left untouched. No-op when disabled.
+BLINK_COMMON_EXPORT void PerturbPixels8888(base::span<uint8_t> pixels);
+
+// Multiplies every sample by a seed-derived gain that differs from 1.0 by
+// less than 1e-5. No-op when disabled.
+BLINK_COMMON_EXPORT void PerturbAudioSamples(base::span<float> samples);
+
+}  // namespace blink::fingerprint
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_FINGERPRINT_CONFIG_H_
